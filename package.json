{
  "name": "tracelens",
  "version": "1.0.0",
  "description": "PeopleCode Trace Analyzer — parse and analyze large PeopleCode trace files with AI-powered insights",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "client": "cd client && npx vite --port 5173",
    "build": "cd client && npm install --include=dev && npx vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
