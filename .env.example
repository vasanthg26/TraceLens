# ==========================================
# TraceLens Configuration
# ==========================================

# Server
NODE_ENV=development
PORT=3000
MAX_FILE_SIZE_MB=1024

# Security
RATE_LIMIT_ENABLED=false
WHITELISTED_IPS=127.0.0.1,::1

# ==========================================
# LLM Provider — change this one line to switch
# Options: groq | openai | ollama | lmstudio | openrouter
# ==========================================
LLM_PROVIDER=groq

# Groq (free tier — get key at console.groq.com)
# Powers all basic features — never shown to users
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (optional — used when no user key provided)
# User's own Anthropic key takes priority over this
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama (local — no key needed)
OLLAMA_MODEL=qwen2.5-coder:7b

# LM Studio (local — no key needed)
LMSTUDIO_MODEL=local-model

# OpenRouter (free models available)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# General LLM Settings
LLM_TEMPERATURE=0.3

# Parser Settings
SLOW_QUERY_THRESHOLD_SECS=1
